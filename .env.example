# ==============================================================================
# CampusGrid Environment Variables Template (.env.example)
# Copy this file to .env.development or .env.local for local development.
# NEVER commit secret keys or environment files to version control.
# ==============================================================================

# ── Database Configuration ───────────────────────────────────────────────────
# PostgreSQL Database Connection URL (Local or Neon Serverless PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/campus_grid_db?sslmode=disable

# ── Authentication & Security ─────────────────────────────────────────────────
# JWT Secret Key for platform token signing (Required, min 32 chars)
JWT_SECRET=your_jwt_secret_key_change_in_production_32_chars_min

# ── Redis Configuration (Optional / Fallback to Memory Cache) ──────────────────
# Redis connection URL for caching and rate limiting
REDIS_URL=redis://localhost:6379

# ── Server & Runtime Environment ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
