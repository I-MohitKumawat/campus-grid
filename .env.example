# ─────────────────────────────────────────────
# CampusGrid — Environment Configuration
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to version control
# ─────────────────────────────────────────────

# ── Application ───────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database (PostgreSQL via Neon DB) ─────────
DATABASE_URL=postgresql://user:password@host/campus_grid?sslmode=require

# ── Auth (Clerk) ──────────────────────────────
# Clerk Dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Allowed college email domain (checked during onboarding)
ALLOWED_EMAIL_DOMAINS=["college.ac.in"]

# ── JWT (Backend-issued session token) ────────
# Generate with: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-min-64-chars-long

# ── Redis (Upstash or local) ──────────────────
REDIS_URL=redis://localhost:6379
# For Upstash (production):
# REDIS_URL=rediss://:password@hostname:port

# ── Cloudinary ────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Resend (Email) ────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@campusgrid.in

# ── Anthropic (Claude AI) ─────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── GitHub OAuth (for skill verification) ─────
GITHUB_CLIENT_ID=your_client_id
GITHUB_CLIENT_SECRET=your_client_secret
GITHUB_REDIRECT_URI=http://localhost:3000/api/v1/verify/github/callback
